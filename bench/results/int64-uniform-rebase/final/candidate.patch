+#if defined(__SSE2__)
+    static bool narrowOverlap(const Box<T>& a, const Box<T>& b, Boundary boundary) noexcept
+        requires std::same_as<T, std::int64_t>
+    {
+        // Subtract low words modulo 2^32. Each difference is the exact signed
+        // gap because withPairKernel checked the joint span before traversal.
+        const auto pack = [](const Box<T>& box) noexcept
+        {
+            __m128 lo, hi;
+            std::memcpy(&lo, &box.minX, sizeof(lo));
+            std::memcpy(&hi, &box.maxX, sizeof(hi));
+            return _mm_castps_si128(_mm_shuffle_ps(lo, hi, _MM_SHUFFLE(2, 0, 2, 0)));
+        };
+        const auto x = pack(a), y = pack(b);
+        const auto gap = _mm_sub_epi32(_mm_unpackhi_epi64(y, x), _mm_unpacklo_epi64(x, y));
+        if (_mm_movemask_ps(_mm_castsi128_ps(gap)) != 0)
+            return false;
+        return _mm_movemask_epi8(_mm_cmpeq_epi32(gap, _mm_setzero_si128())) == 0 ||
+            boundary == Boundary::TouchInclusive || a.minX == a.maxX || a.minY == a.maxY ||
+            b.minX == b.maxX || b.minY == b.maxY;
+    }
+#endif
