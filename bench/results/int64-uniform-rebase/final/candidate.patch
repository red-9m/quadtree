+    template<typename Predicate, typename Run>
+    void withPairKernel(Predicate& predicate, Run run) const noexcept
+    {
+#if defined(__SSE2__)
+        if constexpr (std::same_as<T, std::int64_t> && std::same_as<Predicate, detail::AcceptAll>)
