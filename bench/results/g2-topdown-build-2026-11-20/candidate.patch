+                const auto y = box.minY + static_cast<T>(height / 2);
+                b = 1 + ((split.splitX && x >= split.x ? 1u : 0u) |
+                    (split.splitY && y >= split.y ? 2u : 0u));
+            }
+            tags[i].level = b;
