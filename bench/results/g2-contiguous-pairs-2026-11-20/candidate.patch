+                const auto filter = mEntries.mMeta[a].filter;
+                const bool closed = mConfig.boundary == Boundary::TouchInclusive ||
+                    source.minX == source.maxX || source.minY == source.maxY;
+                const auto classify = [&](std::uint32_t i) noexcept -> unsigned
+                {
+                    if (!detail::compatible(filter, mEntries.mMeta[i].filter))
+                        return 0;
+                    const auto& box = mEntries.mBoxes[i];
+                    if (!detail::closedOverlap(source, box))
+                        return 1;
+                    return (closed || box.minX == box.maxX || box.minY == box.maxY ||
+                        (source.minX < box.maxX && box.minX < source.maxX &&
