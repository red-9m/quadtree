+                }
+                for (; b < end && context.active(); ++b)
+                    testPair(a, b, false, context, visitor, predicate);
+                return;
+            }
+        }
+        for (auto b = begin; b != none && context.active(); b = nextItem(target, b))
+            testPair(a, b, false, context, visitor, predicate);
+    }
