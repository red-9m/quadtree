+                            auto& c = context.result.counters;
+                            const auto max = std::numeric_limits<std::uint64_t>::max();
+                            c.candidateTests += std::min<std::uint64_t>(candidates, max - c.candidateTests);
+                            c.filterRejections += std::min<std::uint64_t>(4 - candidates, max - c.filterRejections);
+                        }
+                    }
+                    else
