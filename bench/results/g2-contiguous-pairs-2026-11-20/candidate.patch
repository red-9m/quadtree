+                        const auto candidates = x + y + z + w;
+                        auto& remaining = context.remaining.candidateTests;
+                        if (remaining != std::numeric_limits<std::uint64_t>::max())
+                            remaining -= candidates;
+                        if constexpr (Instrumented)
