+        auto* records = ::new (scratch.mTemp.data()) OrderedBox[n];
+        for (std::uint32_t i = 0; i < n; ++i) records[scratch.mOrder[i]].ordinal = i;
+        for (std::uint32_t i = 0; i < n; ++i)
