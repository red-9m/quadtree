+            r.gapTerms[1] = 0u - static_cast<std::uint32_t>(box.minY);
+            r.gapTerms[2] = static_cast<std::uint32_t>(box.maxX);
+            r.gapTerms[3] = static_cast<std::uint32_t>(box.maxY);
+            r.threshold = mConfig.boundary == Boundary::TouchInclusive || box.minX == box.maxX || box.minY == box.maxY ? -1 : 0;
+        }
