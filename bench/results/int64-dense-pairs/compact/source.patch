+        const auto words = 1 + (n - 1) / 64, groups = 1 + (words - 1) / 64;
+        auto* bits = scratch.mKeys.data(); // Paired build reservation with mTemp.
+        for (std::uint32_t j = 0; j < words; ++j) bits[j].hi = 0;
+        for (std::uint32_t j = 0; j < groups; ++j) bits[j].lo = 0;
+        auto* ordinal = ::new (scratch.mTemp.data()) std::uint32_t[n];
+        for (std::uint32_t i = 0; i < n; ++i) ordinal[scratch.mOrder[i]] = i;
+        auto* nodes = ::new (scratch.mTemp.data() + sizeof(*ordinal) * n) OrderedNode[mNodeUsed];
+        const auto& root = mNodes[mRoot].bounds;
+        const auto rebase = [&](const Box<T>& b) noexcept -> Box<std::int32_t>
+        {
+            return {static_cast<std::int32_t>(b.minX - root.minX), static_cast<std::int32_t>(b.minY - root.minY),
+                static_cast<std::int32_t>(b.maxX - root.minX), static_cast<std::int32_t>(b.maxY - root.minY)};
+        };
+        for (std::uint32_t j = 0; j < mNodeUsed; ++j)
+        {
