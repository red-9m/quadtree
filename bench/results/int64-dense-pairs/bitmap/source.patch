+    // Ordered queries revisit spatially adjacent entries for many rank rows.
+    // Reuse the build scratch for both their inverse ranks and exact low-word
+    // geometry. One record fits in the bytes already reserved for one key.
+    struct OrderedBox
+    {
+        std::uint32_t gapTerms[4]; // -minX, -minY, maxX, maxY, modulo 2^32
+        std::uint32_t ordinal;
+        std::int32_t threshold; // -1 for closed contact, otherwise 0
+    };
+    static_assert(sizeof(OrderedBox) == sizeof(Key) && alignof(OrderedBox) <= alignof(Key));
+
+    // Rows contain unique ordinals. A two-level bitmap gives long rows linear
+    // ordering without rank comparisons; clear only the marked words on read.
+    static void orderOrdinalRow(std::uint32_t* row, std::uint32_t count, Key* bits, std::uint32_t groups) noexcept
+    {
+        if (count < 128 || groups > count)
+        {
+            std::sort(row, row + count);
+            return;
+        }
+        for (std::uint32_t j = 0; j < count; ++j)
+        {
+            const auto v = row[j], word = v / 64;
+            bits[word].hi |= std::uint64_t(1) << (v % 64);
+            bits[word / 64].lo |= std::uint64_t(1) << (word % 64);
+        }
+        for (std::uint32_t g = 0; g < groups; ++g)
+        {
+            auto words = std::exchange(bits[g].lo, 0);
+            while (words)
+            {
+                const auto word = g * 64 + static_cast<unsigned>(std::countr_zero(words));
+                auto values = std::exchange(bits[word].hi, 0);
+                while (values)
+                {
+                    *row++ = word * 64 + static_cast<unsigned>(std::countr_zero(values));
+                    values &= values - 1;
+                }
+                words &= words - 1;
+            }
+        }
+    }
