+    void sortFullPartnerRow(Workspace<T>& scratch, std::size_t count) const noexcept
+    {
+        auto* row = scratch.mRow.data();
+        if constexpr (std::same_as<T, std::int32_t>)
+        {
+            // Reuse the inactive build buffer when the caller reserved it.
+            // Query-only reservations still take the allocation-free index sort.
+            if (count > 64 && count <= scratch.mTemp.capacity())
+            {
+                auto* keys = scratch.mTemp.data();
+                for (std::size_t i = 0; i < count; ++i)
+                    keys[i] = Key{mEntries.mMeta[row[i]].rank, 0, 0, row[i]};
+                detail::rankSort(keys, count, [](const Key& a, const Key& b) noexcept { return a.hi < b.hi; });
+                for (std::size_t i = 0; i < count; ++i)
+                    row[i] = keys[i].entry;
+                return;
+            }
+        }
+        sortRanks(row, count);
+    }
