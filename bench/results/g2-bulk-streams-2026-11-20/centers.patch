+// The top-down classifier reuses the same center and span at every split.
+struct BulkGeometry
+{
+    std::int32_t x, y;
+    std::uint32_t width, height;
+
+    static constexpr BulkGeometry capture(const Box<std::int32_t>& box) noexcept
+    {
+        return {std::midpoint(box.minX, box.maxX), std::midpoint(box.minY, box.maxY),
+            std::uint32_t(box.maxX) - std::uint32_t(box.minX),
+            std::uint32_t(box.maxY) - std::uint32_t(box.minY)};
+    }
+
+    constexpr Box<std::int32_t> box() const noexcept
+    {
+        const auto min_x = x - static_cast<std::int32_t>(width / 2);
+        const auto min_y = y - static_cast<std::int32_t>(height / 2);
+        return {min_x, min_y, static_cast<std::int32_t>(std::uint32_t(min_x) + width),
+            static_cast<std::int32_t>(std::uint32_t(min_y) + height)};
+    }
+};
